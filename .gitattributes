# Normalize all text files to LF in the repo and in the working tree.
# Shell scripts are mounted into Linux containers and must stay LF.
* text=auto eol=lf

*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.exe binary
